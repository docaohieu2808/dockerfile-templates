{
    "name": "templates/laravel-sample",
    "type": "project",
    "require": {
        "php": "^8.3",
        "laravel/framework": "^13.38"
    },
    "autoload": {
        "psr-4": { "App\\": "app/" }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
